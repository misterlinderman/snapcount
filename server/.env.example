# Server Configuration
PORT=3001
NODE_ENV=development

# MongoDB Configuration
# Get this from MongoDB Atlas: Connect -> Connect your application
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/baseapp?retryWrites=true&w=majority

# Auth0 Configuration
# Get these from your Auth0 Application/API Settings
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=http://localhost:3001/api

# Production only — comma-separated browser origins allowed to call the API (CORS).
# Preferred over legacy CLIENT_URL.
CLIENT_ORIGIN=https://your-production-domain.com
# Optional legacy single origin (used if CLIENT_ORIGIN is unset)
# CLIENT_URL=https://your-production-domain.com

# Optional: Sentry Node (5xx capture in errorHandler; no default PII)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# LOG_LEVEL=info
